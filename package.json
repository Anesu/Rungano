{
  "name": "rungano",
  "version": "0.1.0",
  "description": "Rungano — Shona folktale narrator. Native desktop shell for Higgs Audio v3 TTS with voice cloning and emotion/style/SFX control.",
  "main": "electron/main.js",
  "author": "Anesu Mukusha",
  "license": "SEE LICENSE IN LICENSE.md (non-commercial research use; underlying model: Boson Higgs Audio v3 Research License)",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "server\\.venv\\Scripts\\python.exe -m pytest server/tests -q",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {},
  "build": {
    "appId": "com.anesu.higgs-tts",
    "productName": "Rungano",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "LICENSE.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
